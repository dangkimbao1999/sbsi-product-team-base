{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "chrome-devtools-mcp",
      "args": [
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "env": {}
    },
    "TalkToFigma": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "cursor-talk-to-figma-mcp@latest"
      ],
      "env": {}
    },
    "linear-server": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "atlassian-rovo": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "stitch": {
      "type": "stdio",
      "command": "bunx",
      "args": [
        "@_davideast/stitch-mcp@latest",
        "proxy"
      ],
      "env": {}
    }
  }
}